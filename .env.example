# Required
ANTHROPIC_API_KEY=sk-ant-...

# Database and file storage (defaults shown; override as needed)
DATABASE_URL=sqlite:///./data/midi_haul.db
MIDI_STORAGE_DIR=./data/midi_files

# Scraper settings
SCRAPE_RATE_LIMIT_DELAY=1.5       # seconds (float) between requests per scraper

# Agent settings
AGENT_SCHEDULE_CRON=0 2 * * *    # cron expression, UTC
AGENT_MAX_STEPS=20
CRAWLER_MAX_DEPTH=3

# Logging
LOG_LEVEL=INFO

# Optional: Brave Search API for agent source discovery (leave blank to disable)
BRAVE_SEARCH_API_KEY=bsa-...
